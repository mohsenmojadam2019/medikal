.page {
  min-height: 100vh;
  color: #19344f;
  background: #f8fbfe;
}

.container {
  width: min(1280px, calc(100% - 40px));
  margin-inline: auto;
}

.header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.97);
  border-bottom: 1px solid #e4edf5;
  backdrop-filter: blur(16px);
}

.topBar {
  background: #f4f9fd;
  border-bottom: 1px solid #edf2f7;
}

.topBarInner {
  min-height: 34px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #6d7f91;
  font-size: 12px;
}

.topBarInner a {
  color: #087fdd;
}

.mainHeader {
  padding: 14px 0;
}

.headerRow {
  display: grid;
  grid-template-columns: 220px minmax(300px, 1fr) auto;
  gap: 22px;
  align-items: center;
}

.logo {
  display: flex;
  gap: 11px;
  align-items: center;
  color: #173a5d;
}

.logoIcon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  color: white;
  font-size: 23px;
  border-radius: 16px;
  background: linear-gradient(135deg, #087fdd, #10b4b8);
}

.logo strong {
  display: block;
  font-size: 21px;
}

.logo small {
  display: block;
  margin-top: 2px;
  color: #8190a0;
  font-size: 10px;
}

.headerSearch {
  height: 50px;
  padding-inline: 15px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 10px;
  align-items: center;
  border: 1px solid #dce7f0;
  border-radius: 15px;
  background: #f8fbfd;
}

.headerSearch input {
  width: 100%;
  border: 0;
  outline: 0;
  color: #24445f;
  background: transparent;
}

.headerSearch button {
  height: 36px;
  padding: 0 18px;
  color: white;
  cursor: pointer;
  border: 0;
  border-radius: 10px;
  background: #087fdd;
}

.headerActions {
  display: flex;
  gap: 10px;
  align-items: center;
}

.languageSelect,
.loginButton {
  min-height: 42px;
  padding: 0 12px;
  display: flex;
  gap: 7px;
  align-items: center;
  color: #405b73;
  border: 1px solid #dfe8f1;
  border-radius: 12px;
  background: white;
}

.languageSelect select {
  border: 0;
  outline: 0;
  background: transparent;
}

.loginButton {
  color: white;
  border-color: #087fdd;
  background: #087fdd;
}

.desktopNav {
  border-top: 1px solid #edf2f7;
}

.navRow {
  min-height: 50px;
  display: flex;
  gap: 25px;
  align-items: center;
}

.navRow > a {
  color: #40566e;
  font-size: 14px;
  font-weight: 700;
}

.megaRoot {
  position: relative;
  align-self: stretch;
  display: flex;
  align-items: center;
}

.megaTrigger {
  height: 39px;
  padding: 0 16px;
  display: flex;
  gap: 8px;
  align-items: center;
  color: white;
  font-weight: 800;
  cursor: pointer;
  border: 0;
  border-radius: 11px;
  background: linear-gradient(135deg, #087fdd, #119ebc);
}

.megaPanel {
  width: 920px;
  min-height: 390px;
  position: absolute;
  top: calc(100% + 7px);
  inset-inline-start: 0;
  display: grid;
  grid-template-columns: 225px 1fr 245px;
  overflow: hidden;
  border: 1px solid #e0e8f1;
  border-radius: 20px;
  background: white;
  box-shadow: 0 25px 70px rgba(31, 66, 98, 0.22);
}

.megaSidebar {
  padding: 12px 0;
  background: #f5f9fd;
  border-inline-end: 1px solid #e5edf5;
}

.megaSidebarItem,
.megaSidebarActive {
  width: 100%;
  min-height: 57px;
  padding: 0 17px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #4c6379;
  text-align: start;
  cursor: pointer;
  border: 0;
  background: transparent;
}

.megaSidebarActive {
  color: #087fdd;
  font-weight: 800;
  background: white;
  border-inline-start: 4px solid #087fdd;
}

.megaContent {
  padding: 29px;
}

.megaColumns {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30px;
}

.megaColumns h3 {
  margin: 0 0 18px;
  color: #173a58;
}

.megaColumns a {
  min-height: 43px;
  padding: 0 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #52687e;
  border-radius: 10px;
}

.megaColumns a:hover {
  color: #087fdd;
  background: #f0f8ff;
}

.megaPromo {
  padding: 28px 22px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  color: white;
  background: linear-gradient(150deg, #104b7d, #0c9ca4);
}

.megaPromo span {
  width: fit-content;
  padding: 5px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.16);
}

.megaPromo strong {
  margin-top: 18px;
  font-size: 21px;
  line-height: 1.7;
}

.megaPromo p {
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.9;
}

.megaPromo a {
  color: white;
  font-weight: 800;
}

.heroSection {
  padding: 30px 0 10px;
}

.hero {
  min-height: 440px;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  overflow: hidden;
  border: 1px solid #d9e9f7;
  border-radius: 30px;
  background:
    radial-gradient(circle at 90% 10%, rgba(55, 202, 211, 0.28), transparent 32%),
    linear-gradient(135deg, #f6fbff, #eaf7ff);
  box-shadow: 0 25px 70px rgba(30, 85, 124, 0.11);
}

.heroContent {
  padding: 54px;
}

.heroBadge,
.sectionEyebrow {
  display: inline-flex;
  gap: 7px;
  align-items: center;
  color: #087fdd;
  font-size: 13px;
  font-weight: 800;
}

.heroContent h1 {
  margin: 15px 0;
  color: #173751;
  font-size: clamp(34px, 4vw, 52px);
  line-height: 1.45;
}

.heroContent h1 strong {
  display: block;
  color: #0b91a3;
}

.heroContent > p {
  max-width: 690px;
  color: #63768a;
  line-height: 2;
}

.heroSearch {
  height: 55px;
  margin-top: 24px;
  padding-inline: 16px 8px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 10px;
  align-items: center;
  border: 1px solid #d7e4ef;
  border-radius: 16px;
  background: white;
  box-shadow: 0 13px 35px rgba(37, 82, 116, 0.1);
}

.heroSearch input {
  border: 0;
  outline: 0;
  background: transparent;
}

.heroSearch button {
  height: 42px;
  padding: 0 22px;
  color: white;
  cursor: pointer;
  border: 0;
  border-radius: 12px;
  background: #087fdd;
}

.heroButtons {
  margin-top: 17px;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.heroButtons a {
  min-height: 46px;
  padding: 0 19px;
  display: flex;
  gap: 8px;
  align-items: center;
  color: white;
  font-weight: 800;
  border-radius: 13px;
  background: #087fdd;
}

.heroButtons a + a {
  color: #087fdd;
  border: 1px solid #bcdcf3;
  background: white;
}

.heroTrust {
  margin-top: 23px;
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  color: #587087;
  font-size: 12px;
}

.heroTrust span {
  display: flex;
  gap: 6px;
  align-items: center;
}

.heroTrust svg {
  color: #11a684;
}

.heroImage {
  min-height: 440px;
  position: relative;
  overflow: hidden;
}

.heroImage img {
  width: 100%;
  height: 100%;
  max-height: 440px;
  position: absolute;
  inset: 0;
  object-fit: cover;
  object-position: center top;
  mix-blend-mode: multiply;
}

.heroShape {
  width: 360px;
  height: 360px;
  position: absolute;
  top: 45px;
  right: 45px;
  border-radius: 43% 57% 63% 37%;
  background: linear-gradient(145deg, rgba(70, 201, 214, 0.5), rgba(29, 118, 207, 0.2));
}

.heroFloatingCard {
  min-width: 210px;
  padding: 14px;
  position: absolute;
  left: 25px;
  bottom: 35px;
  z-index: 3;
  display: flex;
  gap: 10px;
  align-items: center;
  color: #284760;
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16px 40px rgba(32, 75, 108, 0.15);
}

.heroFloatingCard > svg {
  color: #11a684;
  font-size: 25px;
}

.heroFloatingCard span {
  font-weight: 800;
}

.heroFloatingCard small {
  display: block;
  margin-top: 2px;
  color: #8190a0;
  font-size: 10px;
  font-weight: 500;
}

.section {
  margin-top: 68px;
}

.sectionHeading {
  margin-bottom: 25px;
  display: flex;
  justify-content: space-between;
  align-items: end;
}

.sectionHeading h2 {
  margin: 7px 0 5px;
  color: #173751;
  font-size: 29px;
}

.sectionHeading p {
  margin: 0;
  color: #728295;
}

.sectionHeading > a {
  color: #087fdd;
  font-weight: 800;
}

.servicesGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.serviceCard {
  min-height: 170px;
  padding: 23px;
  position: relative;
  display: flex;
  flex-direction: column;
  color: #2f4b65;
  border: 1px solid #e0e9f2;
  border-radius: 21px;
  background: white;
  box-shadow: 0 14px 40px rgba(39, 74, 105, 0.07);
  transition: 0.22s ease;
}

.serviceCard:hover {
  color: #087fdd;
  transform: translateY(-6px);
  border-color: #b7daf2;
  box-shadow: 0 24px 55px rgba(35, 89, 132, 0.13);
}

.serviceIcon {
  width: 52px;
  height: 52px;
  margin-bottom: 16px;
  display: grid;
  place-items: center;
  color: #087fdd;
  font-size: 24px;
  border-radius: 17px;
  background: #edf7ff;
}

.serviceCard strong {
  font-size: 17px;
}

.serviceCard p {
  margin: 8px 0;
  color: #7b8999;
  font-size: 12px;
  line-height: 1.8;
}

.serviceCard > svg {
  position: absolute;
  inset-inline-end: 18px;
  bottom: 18px;
}

.adsGrid {
  display: grid;
  grid-template-columns: 1.25fr 1fr 1fr;
  gap: 15px;
}

.adCard {
  min-height: 320px;
  position: relative;
  overflow: hidden;
  border-radius: 23px;
  background: #143754;
}

.adCard img {
  width: 100%;
  height: 100%;
  position: absolute;
  inset: 0;
  object-fit: cover;
}

.adOverlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(11, 39, 66, 0.96), rgba(11, 39, 66, 0.45));
}

.adContent {
  max-width: 500px;
  padding: 34px;
  position: relative;
  z-index: 2;
  color: white;
}

.adMeta {
  display: flex;
  gap: 10px;
  align-items: center;
}

.adMeta > span {
  padding: 5px 10px;
  color: #442e00;
  font-size: 11px;
  border-radius: 999px;
  background: #ffd65c;
}

.adMeta small {
  display: flex;
  gap: 5px;
  align-items: center;
  color: rgba(255, 255, 255, 0.8);
}

.adContent h3 {
  margin: 17px 0 8px;
  color: white;
  font-size: 28px;
  line-height: 1.55;
}

.adContent p {
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.9;
}

.adActions {
  margin-top: 22px;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.adActions a,
.adActions button {
  min-height: 43px;
  padding: 0 15px;
  display: flex;
  gap: 7px;
  align-items: center;
  color: white;
  font-weight: 800;
  cursor: pointer;
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.12);
}

.adActions a {
  border-color: #087fdd;
  background: #087fdd;
}

.doctorsGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.doctorCard {
  padding: 23px;
  text-align: center;
  border: 1px solid #e0e9f2;
  border-radius: 21px;
  background: white;
  box-shadow: 0 14px 40px rgba(40, 72, 101, 0.07);
}

.doctorAvatar {
  width: 92px;
  height: 92px;
  margin: auto;
  display: grid;
  place-items: center;
  overflow: hidden;
  color: #087fdd;
  font-size: 36px;
  border-radius: 50%;
  background: #edf7ff;
}

.doctorAvatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.doctorCard h3 {
  margin: 15px 0 5px;
}

.doctorCard p {
  margin: 0 0 9px;
  color: #7b8999;
  font-size: 13px;
}

.doctorRating {
  margin-bottom: 14px;
  display: flex;
  gap: 5px;
  justify-content: center;
  color: #f1a91f;
}

.doctorCard > a {
  min-height: 42px;
  display: grid;
  place-items: center;
  color: #087fdd;
  font-weight: 800;
  border: 1px solid #cce3f4;
  border-radius: 11px;
}

.homeDoctorBanner,
.mapBanner,
.tourismBanner {
  min-height: 360px;
  margin-top: 68px;
  display: grid;
  overflow: hidden;
  border-radius: 28px;
}

.homeDoctorBanner {
  grid-template-columns: 1.1fr 0.9fr;
  padding: 48px;
  background: linear-gradient(135deg, #eafbf9, #edf7ff);
}

.homeDoctorBanner h2,
.mapBanner h2,
.tourismBanner h2 {
  margin: 13px 0 9px;
  font-size: 31px;
}

.homeDoctorBanner p,
.mapBanner p,
.tourismBanner p {
  color: #60768a;
  line-height: 2;
}

.homeDoctorBanner ul {
  padding: 0;
  display: grid;
  gap: 9px;
  list-style: none;
}

.homeDoctorBanner li {
  display: flex;
  gap: 8px;
  align-items: center;
  color: #45647b;
}

.homeDoctorBanner li svg {
  color: #0fa983;
}

.homeDoctorBanner > div:first-child > a,
.mapBanner > div:first-child > a,
.tourismBanner > div:last-child > a {
  width: fit-content;
  min-height: 46px;
  padding: 0 18px;
  margin-top: 15px;
  display: flex;
  gap: 8px;
  align-items: center;
  color: white;
  font-weight: 800;
  border-radius: 12px;
  background: #087fdd;
}

.homeDoctorBanner small {
  display: block;
  margin-top: 13px;
  color: #96636d;
}

.bannerLabel {
  width: fit-content;
  padding: 6px 11px;
  color: #087fdd;
  border-radius: 999px;
  background: white;
}

.bannerIllustration {
  display: grid;
  grid-template-columns: 1fr 1fr;
  place-items: center;
  color: white;
  font-size: 100px;
  border-radius: 25px;
  background: linear-gradient(145deg, #0e9ca4, #087fdd);
}

.pharmacyTabs {
  margin-bottom: 22px;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.pharmacyTab,
.pharmacyTabActive {
  min-height: 42px;
  padding: 0 17px;
  color: #526b80;
  font-weight: 800;
  cursor: pointer;
  border: 1px solid #dce7f0;
  border-radius: 999px;
  background: white;
}

.pharmacyTabActive {
  color: white;
  border-color: #087fdd;
  background: #087fdd;
}

.productScrollerWrapper {
  position: relative;
}

.productScroller {
  padding: 2px 1px 18px;
  display: flex;
  gap: 15px;
  overflow-x: auto;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.productScroller::-webkit-scrollbar {
  display: none;
}

.productCard {
  flex: 0 0 225px;
  overflow: hidden;
  border: 1px solid #e0e9f2;
  border-radius: 20px;
  background: white;
  box-shadow: 0 13px 35px rgba(42, 74, 103, 0.07);
}

.productImage {
  height: 170px;
  display: grid;
  place-items: center;
  color: #0a9c90;
  font-size: 55px;
  background: linear-gradient(145deg, #f2faff, #edf9f5);
}

.productImage img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.productBody {
  padding: 16px;
}

.productBody h3 {
  min-height: 45px;
  margin: 0 0 4px;
  font-size: 14px;
}

.productBody > span {
  display: block;
  color: #8996a4;
  font-size: 11px;
}

.productBody > strong {
  display: block;
  margin: 12px 0;
  color: #087fdd;
  font-size: 14px;
}

.productBody > a {
  color: #0b948d;
  font-size: 12px;
  font-weight: 800;
}

.scrollPrevious,
.scrollNext {
  width: 42px;
  height: 42px;
  position: absolute;
  top: 44%;
  z-index: 4;
  display: grid;
  place-items: center;
  color: #087fdd;
  cursor: pointer;
  border: 1px solid #dce7f0;
  border-radius: 50%;
  background: white;
  box-shadow: 0 10px 25px rgba(42, 73, 100, 0.15);
}

.scrollPrevious {
  right: -15px;
}

.scrollNext {
  left: -15px;
}

.pharmacyListHeading {
  margin: 25px 0 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pharmacyListHeading h3 {
  display: flex;
  gap: 8px;
  align-items: center;
}

.pharmacyListHeading a {
  color: #087fdd;
  font-weight: 800;
}

.pharmacyGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
}

.pharmacyCard {
  min-height: 88px;
  padding: 13px;
  display: grid;
  grid-template-columns: 52px 1fr auto;
  gap: 11px;
  align-items: center;
  color: #29465e;
  border: 1px solid #e0e9f2;
  border-radius: 17px;
  background: white;
}

.pharmacyLogo {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  overflow: hidden;
  color: #0aa07e;
  font-size: 22px;
  border-radius: 15px;
  background: #ecfaf5;
}

.pharmacyLogo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pharmacyCard strong {
  display: block;
}

.pharmacyCard span {
  display: block;
  margin-top: 3px;
  color: #8492a1;
  font-size: 11px;
}

.pharmacyCard small {
  color: #087fdd;
}

.mapBanner {
  grid-template-columns: 0.85fr 1.15fr;
  background: linear-gradient(135deg, #edf8ff, #edfaf5);
}

.mapBanner > div:first-child,
.tourismBanner > div:last-child {
  padding: 48px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.fakeMap {
  min-height: 360px;
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(30deg, transparent 24%, #d2e7e5 25%, #d2e7e5 28%, transparent 29%),
    linear-gradient(110deg, #edf7ee, #e7f4f3);
}

.mapPinOne,
.mapPinTwo,
.mapPinThree {
  width: 52px;
  height: 52px;
  position: absolute;
  display: grid;
  place-items: center;
  color: white;
  font-size: 21px;
  border: 5px solid white;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.mapPinOne svg,
.mapPinTwo svg,
.mapPinThree svg {
  transform: rotate(45deg);
}

.mapPinOne {
  top: 25%;
  left: 25%;
  background: #087fdd;
}

.mapPinTwo {
  top: 55%;
  left: 57%;
  background: #0da580;
}

.mapPinThree {
  top: 32%;
  right: 14%;
  background: #755ed1;
}

.tourismBanner {
  grid-template-columns: 0.9fr 1.1fr;
  background: linear-gradient(135deg, #fff5e8, #fffdf8);
}

.tourismImage {
  display: grid;
  place-items: center;
  color: white;
  font-size: 130px;
  background: linear-gradient(145deg, #e49945, #087fdd);
}

.tourismFeatures {
  margin: 18px 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.tourismFeatures span {
  display: flex;
  gap: 7px;
  align-items: center;
  color: #516b7e;
}

.tourismFeatures svg {
  color: #0da580;
}

.specialtiesGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
}

.specialtiesGrid a {
  min-height: 78px;
  padding: 15px;
  display: grid;
  grid-template-columns: 45px 1fr auto;
  gap: 11px;
  align-items: center;
  color: #334f67;
  border: 1px solid #e0e9f2;
  border-radius: 17px;
  background: white;
}

.specialtiesGrid a > svg:first-child {
  width: 45px;
  height: 45px;
  padding: 12px;
  color: #087fdd;
  border-radius: 14px;
  background: #edf7ff;
}

.footer {
  margin-top: 80px;
  color: #bed0df;
  background: #102b43;
}

.footerGrid {
  padding: 60px 0 40px;
  display: grid;
  grid-template-columns: 1.4fr repeat(4, 1fr);
  gap: 35px;
}

.footerLogo {
  color: white;
  font-size: 27px;
  font-weight: 900;
}

.footerBrand p {
  max-width: 340px;
  line-height: 2;
}

.footerTrust {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.footerTrust span {
  padding: 6px 10px;
  display: flex;
  gap: 5px;
  align-items: center;
  font-size: 11px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 999px;
}

.footerColumn h3 {
  margin: 0 0 18px;
  color: white;
  font-size: 15px;
}

.footerColumn > a,
.footerColumn > span {
  margin-bottom: 11px;
  display: flex;
  gap: 7px;
  align-items: center;
  color: #aec1d1;
  font-size: 12px;
}

.socialLinks {
  margin-top: 15px;
  display: flex;
  gap: 8px;
}

.socialLinks a {
  width: 37px;
  height: 37px;
  display: grid;
  place-items: center;
  color: white;
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.08);
}

.footerBottom {
  min-height: 68px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #8fa5b8;
  font-size: 11px;
  border-top: 1px solid rgba(255, 255, 255, 0.09);
}

.footerBottom div {
  display: flex;
  gap: 18px;
}

.footerBottom a {
  color: #9eb3c4;
}

@media (max-width: 1100px) {
  .headerRow {
    grid-template-columns: 190px 1fr auto;
  }

  .servicesGrid,
  .doctorsGrid,
  .pharmacyGrid,
  .specialtiesGrid {
    grid-template-columns: repeat(2, 1fr);
  }

  .adsGrid {
    grid-template-columns: 1fr 1fr;
  }

  .footerGrid {
    grid-template-columns: repeat(3, 1fr);
  }

  .footerBrand {
    grid-column: span 3;
  }
}

@media (max-width: 820px) {
  .container {
    width: calc(100% - 24px);
  }

  .topBar,
  .desktopNav,
  .headerSearch,
  .languageSelect {
    display: none;
  }

  .headerRow {
    display: flex;
    justify-content: space-between;
  }

  .loginButton span {
    display: none;
  }

  .hero {
    display: flex;
    flex-direction: column-reverse;
  }

  .heroImage {
    min-height: 280px;
  }

  .heroImage img {
    max-height: 300px;
  }

  .heroContent {
    padding: 29px 22px 35px;
  }

  .heroContent h1 {
    font-size: 31px;
  }

  .servicesGrid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .serviceCard {
    min-height: 145px;
    padding: 17px;
  }

  .adsGrid {
    grid-template-columns: 1fr;
  }

  .doctorsGrid {
    display: flex;
    overflow-x: auto;
    padding-bottom: 12px;
  }

  .doctorCard {
    flex: 0 0 235px;
  }

  .homeDoctorBanner,
  .mapBanner,
  .tourismBanner {
    display: flex;
    flex-direction: column;
  }

  .bannerIllustration,
  .fakeMap,
  .tourismImage {
    min-height: 270px;
  }

  .pharmacyGrid {
    grid-template-columns: 1fr;
  }

  .footer {
    padding-bottom: 85px;
  }

  .footerGrid {
    grid-template-columns: repeat(2, 1fr);
  }

  .footerBrand {
    grid-column: span 2;
  }
}

@media (max-width: 520px) {
  .logo small {
    display: none;
  }

  .heroImage {
    min-height: 235px;
  }

  .heroContent h1 {
    font-size: 27px;
  }

  .heroSearch {
    grid-template-columns: auto 1fr;
  }

  .heroSearch button {
    grid-column: span 2;
    width: 100%;
  }

  .servicesGrid {
    grid-template-columns: 1fr 1fr;
  }

  .serviceCard {
    min-height: 140px;
  }

  .sectionHeading h2 {
    font-size: 23px;
  }

  .tourismFeatures {
    grid-template-columns: 1fr;
  }

  .specialtiesGrid {
    grid-template-columns: 1fr;
  }

  .footerGrid {
    grid-template-columns: 1fr;
  }

  .footerBrand {
    grid-column: auto;
  }
}

/* DOCTORWEB_INHOME_IMAGE */
.homeDoctorPhoto {
  width: 100%;
  min-height: 360px;
  overflow: hidden;
  border-radius: 24px;
}

.homeDoctorPhoto img {
  width: 100%;
  height: 100%;
  min-height: 360px;
  display: block;
  object-fit: cover;
  object-position: center;
}

@media (max-width: 820px) {
  .homeDoctorPhoto,
  .homeDoctorPhoto img {
    min-height: 270px;
  }
}

