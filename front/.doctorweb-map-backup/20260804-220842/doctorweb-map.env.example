# API واقعی مراکز در Laravel
# مثال در Docker:
# MEDIKAL_MAP_FACILITIES_URL=http://medikall-webserver/api/map/facilities
MEDIKAL_MAP_FACILITIES_URL=

# توسعه: سرویس عمومی OSRM
# نسخه واقعی: آدرس OSRM روی سرور خود پروژه
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# کاشی نقشه
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
